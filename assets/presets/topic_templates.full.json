[
  {
    "name": "标准物模型",
    "description": "基于阿里云标准物模型的 MQTT 主题（$(pkey) 产品Key / $(dev) 设备名 / $(svc) TSL 服务标识）",
    "templates": [
      { "label": "设备属性上报", "topic": "/sys/$(pkey)/$(dev)/thing/event/property/post", "publish": true },
      { "label": "云端响应属性上报", "topic": "/sys/$(pkey)/$(dev)/thing/event/property/post_reply", "publish": false },
      { "label": "设备属性获取", "topic": "/sys/$(pkey)/$(dev)/thing/service/property/get", "publish": false },
      { "label": "云端响应属性获取", "topic": "/sys/$(pkey)/$(dev)/thing/service/property/get_reply", "publish": true },
      { "label": "设备属性设置", "topic": "/sys/$(pkey)/$(dev)/thing/service/property/set", "publish": false },
      { "label": "云端响应属性设置", "topic": "/sys/$(pkey)/$(dev)/thing/service/property/set_reply", "publish": true },
      { "label": "设备事件上报", "topic": "/sys/$(pkey)/$(dev)/thing/event/$(svc)/post", "publish": true },
      { "label": "云端响应事件上报", "topic": "/sys/$(pkey)/$(dev)/thing/event/$(svc)/post_reply", "publish": false },
      { "label": "设备服务调用", "topic": "/sys/$(pkey)/$(dev)/thing/service/$(svc)", "publish": false },
      { "label": "云端响应服务调用", "topic": "/sys/$(pkey)/$(dev)/thing/service/$(svc)_reply", "publish": true }
    ]
  }
]
  {
    "name": "写计数值",
    "description": "FC10 写多寄存器（uint32 高字在前，必须从高字起一次写 2 个）",
    "commands": [
      {
        "label": "写 CH0 值",
        "command": "{\"fc\": 16, \"addr\": 16, \"values\": [0, 100]}",
        "hint": "高字+低字（0x0010-0x0011）"
      },
      {
        "label": "写 CH1 值",
        "command": "{\"fc\": 16, \"addr\": 18, \"values\": [0, 100]}",
        "hint": "高字+低字（0x0012-0x0013）"
      },
      {
        "label": "写 CH2 值",
        "command": "{\"fc\": 16, \"addr\": 20, \"values\": [0, 100]}",

      {
        "label": "计数 CH1 +1",
        "command": "{\"fc\": 6, \"addr\": 0, \"value\": 34}",
        "hint": "命令值 0x0022"
      },
      {
        "label": "计数 CH2 +1",
        "command": "{\"fc\": 6, \"addr\": 0, \"value\": 35}",
        "hint": "命令值 0x0023"
      },
      {
        "label": "计数 CH3 +1",
        "command": "{\"fc\": 6, \"addr\": 0, \"value\": 36}",
        "hint": "命令值 0x0024"
      },
      {
        "label": "复位 CH0",
        "command": "{\"fc\": 6, \"addr\": 0, \"value\": 1}",
        "hint": "命令值 0x0001"
      },
      {
        "label": "复位 CH1",
        "command": "{\"fc\": 6, \"addr\": 0, \"value\": 2}",
